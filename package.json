{
  "name": "oldpump",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A recreation of the classic 2025 pump.fun interface that launches and trades real pump.fun coins",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --watch api/server.mjs",
    "dev:web": "vite web --port 5481",
    "build": "vite build web",
    "start": "NODE_ENV=production node api/server.mjs",
    "test": "node --test test/*.test.mjs",
    "grind": "node scripts/grind.mjs"
  },
  "dependencies": {
    "@coral-xyz/anchor": "^0.31.1",
    "@meteora-ag/dynamic-bonding-curve-sdk": "^1.5.13",
    "@noble/curves": "^2.4.0",
    "@pump-fun/pump-sdk": "^2.0.0",
    "@pump-fun/pump-swap-sdk": "^1.20.0",
    "@solana/spl-token": "^0.4.15",
    "@solana/web3.js": "^1.98.4",
    "@wallet-standard/app": "^1.1.1",
    "bn.js": "^5.2.5",
    "bs58": "^6.0.0",
    "lightweight-charts": "^4.2.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tweetnacl": "^1.0.3"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.0",
    "vite": "^7.1.0"
  }
}
